{
  "name": "@soqaro/web",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node -e \"const fs=require('fs'); if(fs.existsSync('.next/standalone/apps/web')){ fs.cpSync('.next/static','.next/standalone/apps/web/.next/static',{recursive:true}); fs.cpSync('public','.next/standalone/apps/web/public',{recursive:true}); }\"",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@audio/opus-encode": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@soqaro/shared": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tanstack/react-query": "^5.68.0",
    "@wasm-audio-decoders/flac": "0.2.10",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "hash-wasm": "4.12.0",
    "lucide-react": "^1.61.0",
    "mpg123-decoder": "1.0.3",
    "music-metadata": "^11.14.0",
    "next": "^15.5.21",
    "ogg-opus-decoder": "1.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.7.0",
    "wave-resampler": "1.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@soqaro/config-eslint": "workspace:*",
    "@soqaro/config-typescript": "workspace:*",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.22.0",
    "ioredis": "^5.5.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
