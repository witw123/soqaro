{
  "appId": "com.soqaro.app",
  "appName": "Soqaro",
  "webDir": "www",
  "server": {
    "url": "https://soqaro.witw.top/app",
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "soqaro.witw.top"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "loggingBehavior": "none",
  "plugins": {
    "CapacitorCookies": {
      "enabled": true
    },
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
