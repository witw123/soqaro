{
  "name": "soqaro",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @soqaro/web e2e",
    "desktop:dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "mobile:sync": "pnpm --filter @soqaro/mobile sync",
    "build:desktop": "tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "build:app": "pnpm build:desktop",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:linux": "sh scripts/deploy-linux.sh",
    "migrate:p2p-v4": "pnpm --filter @soqaro/server migrate:p2p-v4"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    },
    "overrides": {
      "axios": "1.20.0",
      "basic-ftp": "6.2.1",
      "body-parser@<2": "1.20.9",
      "body-parser@>=2": "2.4.0",
      "brace-expansion@<2": "1.1.20",
      "brace-expansion@>=4": "5.0.11",
      "browserslist": "4.28.7",
      "defu": "6.1.7",
      "effect": "3.22.0",
      "engine.io": "6.6.11",
      "fast-uri": "3.1.7",
      "follow-redirects": "1.16.3",
      "handlebars": "4.7.10",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.2",
      "lodash": "4.18.1",
      "multer": "2.5.0",
      "nanoid": "3.3.18",
      "next": "15.5.28",
      "node-forge": "1.4.3",
      "path-to-regexp": "8.4.2",
      "picomatch": "4.0.4",
      "postcss": "8.5.19",
      "proxy-addr": "2.0.8",
      "qs": "6.15.3",
      "sharp": "0.35.5",
      "socket.io": "4.8.4",
      "socket.io-parser": "4.2.7",
      "source-map-js": "1.2.2",
      "tinypool": "2.1.2",
      "ws": "8.21.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@next/eslint-plugin-next": "^15.2.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.26.1",
    "typescript": "^5.8.2"
  },
  "description": "跨平台多端协同听歌与音乐房应用（Web / Windows / macOS / Linux / Android），支持本地曲库与多音源毫秒级低延迟实时同步"
}
